<UserControl
    x:Class="LawMatic_Calendar.Controls.CourtTimelineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Language="ru-RU">
    <Grid Padding="24,6,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="CaseNumber" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource BrandBrush}" VerticalAlignment="Center"/>
                    <Border Background="{ThemeResource TodayBrush}" Padding="8,3" CornerRadius="4"><TextBlock Text="Апелляция · в производстве" FontSize="11" Foreground="{ThemeResource BrandBrush}"/></Border>
                </StackPanel>
                <TextBlock x:Name="CaseTitle" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CaseSubject" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="Сумма требований" FontSize="11" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right"/>
                <TextBlock x:Name="CaseAmount" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"/>
                <TextBlock Text="Демонстрационное дело" FontSize="10" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="Ход дела" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="3 стадии · 8 событий" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"/>
                <ToggleButton x:Name="PlanToggle" Content="Показать план" IsChecked="True" Click="Plan_Click" FontSize="11" Padding="10,5"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="ZoomOutButton" Content="−" Click="ZoomOut_Click" AutomationProperties.Name="Уменьшить масштаб"/>
                <Button x:Name="FitButton" Content="Весь процесс" Click="Fit_Click" FontSize="11" ToolTipService.ToolTip="Вписать весь процесс в экран"/>
                <Button x:Name="ZoomInButton" Content="＋" Click="ZoomIn_Click" AutomationProperties.Name="Увеличить масштаб"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer x:Name="TimelineScroller" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
                    <Canvas x:Name="TimelineCanvas" Background="{ThemeResource SurfaceBrush}"/>
                </ScrollViewer>
                <Border Grid.Row="1" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,9">
                    <TextBlock Text="━  Факт      ▨  План      ┄  Возможная стадия      ○  Событие" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="3" Padding="16,12" Background="{ThemeResource ShellBrush}" CornerRadius="8" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
            <Grid ColumnSpacing="22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock x:Name="DetailKind" FontSize="10" Foreground="{ThemeResource BrandBrush}"/>
                    <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailDate" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailLocation" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailNote" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
